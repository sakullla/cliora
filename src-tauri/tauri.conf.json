{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cliora",
  "version": "0.2.0",
  "identifier": "com.cliora.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "栖点 · Cliora", "width": 1160, "height": 780, "minWidth": 720, "minHeight": 560, "backgroundColor": "#F5F7F2" }],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self'"
    }
  },
  "bundle": { "active": true, "targets": ["nsis", "dmg", "appimage", "deb"], "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"] }
}
