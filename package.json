{
  "name": "cliora",
  "private": true,
  "version": "0.4.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "node scripts/test-ui.mjs",
    "test:unit": "node --test tests/native/*.test.mjs",
    "test:unit:all": "node scripts/test-unit.mjs",
    "test:e2e": "node scripts/test-ui.mjs",
    "verify": "npm run test:unit && npm run test && npm run build",
    "tauri": "tauri",
    "test:integration": "node scripts/test-ui.mjs --grep @integration --workers=4",
    "test:quick": "node scripts/test-unit.mjs",
    "test:prepare": "npm run build && cargo test --manifest-path src-tauri/Cargo.toml --lib --no-run"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/legacy-modes": "6.5.4",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@lezer/highlight": "1.2.5",
    "@tauri-apps/api": "2.12.0",
    "@tauri-apps/plugin-dialog": "^2.8.0",
    "i18next": "^26.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.0.16",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tauri-apps/cli": "2.12.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "5.9.3",
    "vite": "8.3.1"
  }
}
