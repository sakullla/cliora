{
  "mcpServers": {
    "example-stdio": {
      "command": "npx",
      "args": ["-y", "example-mcp"],
      "env": {
        "EXAMPLE_MODE": "fixture",
        "API_KEY": "${EXAMPLE_KEY}"
      },
      "autoApprove": ["list_tools", "read_file"],
      "disabledTools": ["write_file", "apply_patch"],
      "disabled": false
    },
    "example-remote": {
      "url": "https://mcp.example.com/mcp",
      "headers": {
        "X-Example": "fixture"
      },
      "oauth": {
        "clientId": "fixture-client",
        "clientSecret": "${OAUTH_CLIENT_SECRET}",
        "redirectUri": "https://mcp.example.com/oauth/callback",
        "clientMetadataUrl": "https://mcp.example.com/.well-known/oauth-authorization-server",
        "oauthScopes": ["read", "write"]
      },
      "oauthScopes": ["read"],
      "disabled": true
    }
  }
}
