{
  "$schema": "https://opencode.ai/config.json",
  // The managed provider must not remove this other one.
  "provider": {
    "existing": {
      "npm": "@ai-sdk/openai-compatible",
      "options": { "baseURL": "https://example.test/v1" },
      "models": { "one": { "name": "One" } }
    }
  },
  "mcp": { "local": { "type": "local", "command": ["example"] } }
}
