      },
      {
        "scope": "project",
        "path": ".opencode/opencode.json",
        "content": "{\"mcp\":{\"opencode-wins\":{\"type\":\"local\",\"command\":[\"npx\",\"opencode\"]},\"claude-wins\":{\"type\":\"local\",\"command\":[\"npx\",\"opencode\"]}}}"
      },
      {
        "scope": "project",
        "path": ".claude/mcp.json",
        "content": "{\"mcpServers\":{\"claude-wins\":{\"command\":\"claude\"}}}"
